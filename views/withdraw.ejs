<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Withdraw Funds</title>
  <link rel="stylesheet" href="/style1.css"> 
</head>
<body>

  <!-- Top Navigation -->
  <div class="topnav">
    <a href="/dashboard">Dashboard</a>
    <a href="/deposit">Deposit</a>
    <a href="/withdraw" class="active">Withdraw</a>
    <a href="/history">History</a>
    <a href="/logout">Logout</a>
  </div>

  <!-- Welcome Message -->
  <div class="topnavMessage">
    <span class="welcomeMessage">Hello, <%= user.name %>!</span>
  </div>

  <!-- Main Content -->
  <div class="mainPortfolio">
    <div class="portfolioCard">
      <div class="portfolioHeader">
        <h2>Withdraw Funds</h2>
      </div>

      <div class="portfolioBody">
        <p class="subtext">Current Balance: $<%= user.cashBalance %></p>

        <% if (error) { %>
          <p style="color: red; font-weight: 600;"><%= error %></p>
        <% } %>

        <form action="/withdraw" method="POST">
          <label for="amount">Amount to Withdraw:</label>
          <input type="number" name="amount" id="amount" step="0.01" min="1" required
                 style="margin-top: 10px; margin-bottom: 20px; padding: 10px; width: 100%; border-radius: 6px; border: 1px solid #ccc;">
          <button type="submit"
                  style="background-color: #272EF5; color: white; padding: 12px 20px; border: none; border-radius: 9999px; font-weight: 600; cursor: pointer;">
            Withdraw
          </button>
        </form>

        <a href="/dashboard" class="view-btn">Back to Dashboard</a>
      </div>
    </div>
  </div>

</body>
</html>
