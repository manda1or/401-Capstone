<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Wallet</title>
  <link rel="stylesheet" href="/style1.css">
</head>
<body>

  <!-- Top Navigation -->
  <div class="topnavMessage">
    <div class="welcomeMessage">
      <p>Hello <%= user.name %> (<%= user.role %>)</p>
    </div>
    <div class="topnav">
      <a href="/dashboard">Dashboard</a> 
      <a href="/wallet">Wallet</a>
      <a href="/history">History</a>
      <a href="/logout">Logout</a>
    </div>
  </div>

  <div class="mainPortfolio" style="flex-direction: column; gap: 20px;">

    <!-- Current Balance -->
    <div class="portfolioCard">
      <div class="portfolioHeader">
        <h2>Wallet Overview</h2>
        <p style="margin-top:10px; font-weight:600;">Current Balance: $<%= user.cashBalance.toFixed(2) %></p>
      </div>
    </div>

    <!-- Deposit Section -->
    <div class="portfolioCard">
      <div class="portfolioHeader">
        <h2>Deposit Funds</h2>
      </div>
      <form action="/deposit" method="POST">
        <label>Amount to Deposit</label>
        <input type="number" name="amount" min="1" step="0.01" required
               style="padding:12px;width:100%;margin-top:10px;border-radius:12px;border:1px solid #ccc;">
        <button type="submit"
                style="margin-top:15px;background:#28a745;color:white;padding:14px;width:100%;border:none;border-radius:12px;font-weight:600;">
          Deposit
        </button>
      </form>
    </div>

    <!-- Withdraw Section -->
    <div class="portfolioCard">
      <div class="portfolioHeader">
        <h2>Withdraw Funds</h2>
      </div>
      <% if (error) { %>
        <p style="color: red; font-weight: 600;"><%= error %></p>
      <% } %>
      <form action="/withdraw" method="POST">
        <label>Amount to Withdraw</label>
        <input type="number" name="amount" min="1" step="0.01" required
               style="padding:12px;width:100%;margin-top:10px;border-radius:12px;border:1px solid #ccc;">
        <button type="submit"
                style="margin-top:15px;background:#dc3545;color:white;padding:14px;width:100%;border:none;border-radius:12px;font-weight:600;">
          Withdraw
        </button>
      </form>
    </div>

  </div>

</body>
</html>
