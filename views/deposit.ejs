<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="/style1.css" />
    <title>Deposit Cash</title>
</head>

<body>
<div class="topnavMessage">
    <div class="welcomeMessage">
        <p>Hello <%= user.name %> (<%= user.role %>)</p>
    </div>
    <div class="topnav">
        <a href="/dashboard">Dashboard</a> 
        <a class="active" href="/deposit">Deposit Cash</a>
        <a href="/withdraw">Withdraw</a>
        <a href="/history">History</a>
        <a href="/logout">Logout</a>
    </div>
</div>

<div class="mainPortfolio">
  <div class="portfolioCard">
    <div class="portfolioHeader">
      <h2>Deposit Funds</h2>
    </div>

    <form action="/deposit" method="POST">
      <label>Amount to Deposit</label>
      <input type="number" name="amount" min="1" step="0.01" required style="padding:12px;width:100%;margin-top:10px;border-radius:12px;border:1px solid #ccc;">

      <button type="submit" style="margin-top:15px;background:#272EF5;color:white;padding:14px;width:100%;border:none;border-radius:12px;">Deposit</button>
    </form>
  </div>
</div>

</body>
</html>
