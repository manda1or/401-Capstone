<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/style1.css">
</head>

<body>

<div class="topnavMessage">
  <div class="welcomeMessage">
    <p>Hello <%= user.name %> (Admin)</p>
  </div>

  <div class="topnav">
    <a href="/admin-dashboard">Dashboard</a>
    <a href="/add-stocks">Create Stocks</a>
    <a href="/admin-history">History</a>
    <a href="/logout">Logout</a>
  </div>
</div>

<div class="mainPortfolio">
  <div class="portfolioCard">

    <div class="portfolioHeader">
      <h2>Admin Stock Management</h2>
      <span class="badge">
        Market: <%= marketStatus %>
        <% if (nextOpen) { %>
          <br><small>Next Open: <%= nextOpen %></small>
        <% } %>
      </span>
    </div>

    <div class="portfolioBody">
      <% if (stocks.length === 0) { %>
        <p>No stocks created yet.</p>
      <% } else { %>

        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% stocks.forEach(stock => { %>
            <tr>
              <td><%= stock.name %></td>
              <td>$<%= stock.price.toFixed(2) %></td>
              <td><%= stock.quantity %></td>

              <td>
                <form 
                  action="/admin/delete-stock/<%= stock._id %>" 
                  method="POST" 
                  onsubmit="return confirm('Delete this stock? This removes it from ALL users.')"
                  style="display:inline;"
                >
                  <button class="btn-sell">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>

      <% } %>
    </div>

  </div>
</div>

</body>
</html>
