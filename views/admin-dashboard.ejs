<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/style1.css">
</head>

<body>

<div class="topnavMessage">
  <div class="welcomeMessage">
    <p>Hello <%= user.name %> (Admin)</p>
  </div>

  <div class="topnav">
    <a href="/admin-dashboard">Dashboard</a>
    <a href="/add-stocks">Create Stocks</a>
    <a href="/admin-history">History</a>
    <a href="/logout">Logout</a>
  </div>
</div>

<div class="mainPortfolio">
  <div class="portfolioCard">

    <div class="portfolioHeader">
      <h2>Admin Stock Management</h2>
      <span class="badge">
        Market: <%= marketStatus %>
        <% if (nextOpen) { %>
          <br><small>Next Open: <%= nextOpen %></small>
        <% } %>
      </span>
    </div>

    <!-- ========================== -->
    <!--   NEW MARKET CONTROL FORM  -->
    <!-- ========================== -->
    <div class="portfolioBody">

      <h3>Market Controls</h3>

      <form action="/admin/update-market-settings" method="POST" class="market-controls-form">

        <!-- Holiday Toggle -->
        <label>
          <strong>Market Closed for Holidays:</strong>
          <input type="checkbox" name="holidayClosed" <%= settings.holidayClosed ? "checked" : "" %> >
        </label>
        <br><br>

        <!-- Day Toggles -->
        <h4>Days of the Week</h4>

        <% const days = ["monday","tuesday","wednesday","thursday","friday","saturday","sunday"]; %>

        <% days.forEach(day => { %>
          <label style="display:block; margin-bottom:6px;">
            <%= day.charAt(0).toUpperCase() + day.slice(1) %> Open:
            <input type="checkbox" name="<%= day %>Open" <%= settings[day + "Open"] ? "checked" : "" %> >
          </label>
        <% }) %>

        <br>

        <!-- Open/Close Times -->
        <h4>Market Hours</h4>

        <% days.forEach(day => { %>
          <div style="margin-bottom:10px;">
            <strong><%= day.charAt(0).toUpperCase() + day.slice(1) %></strong><br>

            Open Time:
            <input type="time" name="<%= day %>OpenTime" 
                   value="<%= settings[day + 'OpenTime'] || '09:00' %>">

            Close Time:
            <input type="time" name="<%= day %>CloseTime" 
                   value="<%= settings[day + 'CloseTime'] || '17:00' %>">
          </div>
        <% }) %>

        <button class="btn-sell" style="margin-top:10px;">Save Settings</button>
      </form>

      <hr><br>
      <!-- END OF ADDED SECTION -->

      <% if (stocks.length === 0) { %>
        <p>No stocks created yet.</p>
      <% } else { %>

        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% stocks.forEach(stock => { %>
            <tr>
              <td><%= stock.name %></td>
              <td>$<%= stock.price.toFixed(2) %></td>
              <td><%= stock.quantity %></td>

              <td>
                <form 
                  action="/admin/delete-stock/<%= stock._id %>" 
                  method="POST" 
                  onsubmit="return confirm('Delete this stock? This removes it from ALL users.')"
                  style="display:inline;"
                >
                  <button class="btn-sell">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>

      <% } %>
    </div
